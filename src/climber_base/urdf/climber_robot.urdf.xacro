<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="climber_robot">

  <!-- Arguments -->
  <xacro:arg name="use_sim" default="true"/>
  <xacro:arg name="sim_gz" default="true"/>

  <!-- Properties for Cylinder Climbing Robot -->
  <!-- The robot wraps around a cylinder and climbs it -->
  
  <!-- Cylinder dimensions (the pole being climbed) -->
  <xacro:property name="cylinder_diameter" value=".40"/>  <!-- 30cm diameter pole -->
  <xacro:property name="cylinder_radius" value="${cylinder_diameter/2}"/>
  
  <!-- Mecanum wheel properties -->
  <xacro:property name="wheel_radius" value="0.06"/>  <!-- 6cm radius mecanum wheel -->
  <xacro:property name="wheel_width" value="0.05"/>   <!-- 5cm wide -->
  <xacro:property name="wheel_mass" value="0.4"/>

  <!-- Wheel center distance from cylinder axis (default/home position) -->
  <!-- The inner face of the wheel touches the cylinder surface -->
  <xacro:property name="wheel_radial_distance" value="${cylinder_radius + wheel_width/2}"/>

  <!-- Linear actuator properties (physical stroke coordinates: 0.0 = retracted at limit switch, positive = extending toward cylinder) -->
  <xacro:property name="actuator_stroke" value="0.16"/>       <!-- 16cm total travel -->
  <xacro:property name="actuator_home" value="0.0"/>          <!-- 0 = fully retracted at PIN_ACT_LIMIT_IN -->
  <xacro:property name="actuator_touch" value="0.15"/>        <!-- 15cm extension = touching cylinder surface -->
  <xacro:property name="actuator_min" value="0.0"/>           <!-- 0cm (fully retracted clearance) -->
  <xacro:property name="actuator_max" value="${actuator_stroke}"/>  <!-- 16cm outward (1cm max grip into cylinder) -->
  <xacro:property name="actuator_mass" value="0.3"/>
  <xacro:property name="actuator_length" value="0.06"/>       <!-- Visual length of actuator body -->
  <xacro:property name="actuator_width" value="0.025"/>       <!-- Visual cross-section -->
  
  <!-- Frame properties -->
  <xacro:property name="arm_length" value="0.08"/>             <!-- Radial arm from wheel outward -->
  <xacro:property name="arm_thickness" value="0.02"/>
  <xacro:property name="frame_ring_radius" value="0.565"/> <!-- 1.13m / 2 -->
  <xacro:property name="frame_size" value="1.13"/>
  <xacro:property name="frame_height" value="0.02"/>
  <xacro:property name="base_mass" value="3.0"/>

  <!-- Angles for N, W, S, E formation (0, 90, 180, 270 degrees) -->
  <xacro:property name="angle_n" value="${0}"/>           <!-- 0° - North (+X) -->
  <xacro:property name="angle_w" value="${pi/2}"/>        <!-- 90° - West (+Y) -->
  <xacro:property name="angle_s" value="${pi}"/>          <!-- 180° - South (-X) -->
  <xacro:property name="angle_e" value="${3*pi/2}"/>      <!-- 270° - East (-Y) -->

  <!-- Include materials -->
  <xacro:include filename="$(find climber_base)/urdf/materials.xacro"/>

  <!-- Include ros2_control -->
  <xacro:include filename="$(find climber_base)/urdf/ros2_control.xacro"/>

  <!-- Include Gazebo plugins -->
  <xacro:include filename="$(find climber_base)/urdf/gazebo.xacro"/>

  <!-- Inertia macros -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12}" iyz="0"
             izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
             iyy="${m*(3*r*r+h*h)/12}" iyz="0"
             izz="${m*r*r/2}"/>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0"
             iyy="${2*m*r*r/5}" iyz="0"
             izz="${2*m*r*r/5}"/>
  </xacro:macro>

  <!-- Base Link (center of robot, aligned with cylinder axis) -->
  <link name="base_link"/>

  <!-- Chassis - inertial mass at center (no solid visual to avoid hiding wheels) -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="chassis">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <xacro:cylinder_inertia m="${base_mass}" r="${frame_ring_radius}" h="${frame_height}"/>
    </inertial>
  </link>

  <!-- Radial arm + linear actuator + wheel assembly macro -->
  <!-- Chain: base_link → carriage_anchor (fixed, sets radial direction) -->
  <!--        → actuator_carriage (prismatic, slides radially) -->
  <!--        → wheel (continuous, spins for climbing) -->
  <xacro:macro name="climbing_wheel_assembly" params="prefix angle">
    <!-- Frame ring attachment point (fixed to outer ring) -->
    <joint name="${prefix}_frame_node_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_frame_node"/>
      <origin xyz="${frame_ring_radius * cos(angle)} ${frame_ring_radius * sin(angle)} 0" rpy="0 0 ${angle}"/>
    </joint>

    <link name="${prefix}_frame_node">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${arm_thickness} ${arm_thickness} ${arm_thickness}"/>
        </geometry>
        <material name="blue"/>
      </visual>
    </link>

    <!-- Carriage anchor: fixed to base_link, oriented so X points radially outward -->
    <!-- The prismatic joint will slide along negative X (inward toward cylinder) -->
    <joint name="${prefix}_anchor_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_anchor"/>
      <origin xyz="${frame_ring_radius * cos(angle)} ${frame_ring_radius * sin(angle)} 0" rpy="0 0 ${angle}"/>
    </joint>

    <link name="${prefix}_anchor">
      <!-- Actuator body visual (the static part of the linear actuator) -->
      <visual>
        <origin xyz="${-actuator_length/2} 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${actuator_length} ${actuator_width} ${actuator_width}"/>
        </geometry>
        <material name="red"/>
      </visual>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${actuator_mass / 2}"/>
        <xacro:box_inertia m="${actuator_mass / 2}" x="${actuator_length}" y="${actuator_width}" z="${actuator_width}"/>
      </inertial>
    </link>

    <!-- Linear actuator prismatic joint (physical stroke coordinates) -->
    <!-- Slides along negative X (radially inward, toward cylinder center) -->
    <!-- position=0.00 → fully retracted at chassis limit switch (PIN_ACT_LIMIT_IN) -->
    <!-- position=0.15 → wheel touching cylinder surface -->
    <!-- position=0.16 → max extension (pressing 1cm into cylinder surface) -->
    <joint name="${prefix}_actuator_joint" type="prismatic">
      <parent link="${prefix}_anchor"/>
      <child link="${prefix}_carriage"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="${actuator_min}" upper="${actuator_max}" effort="100.0" velocity="0.1"/>
      <dynamics damping="5.0" friction="1.0"/>
    </joint>

    <link name="${prefix}_carriage">
      <!-- Actuator rod visual (the moving part) -->
      <visual>
        <origin xyz="${-(frame_ring_radius - (wheel_radial_distance + actuator_touch))/2} 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${frame_ring_radius - (wheel_radial_distance + actuator_touch)} ${actuator_width * 0.6} ${actuator_width * 0.6}"/>
        </geometry>
        <material name="grey"/>
      </visual>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${actuator_mass / 2}"/>
        <xacro:box_inertia m="${actuator_mass / 2}" x="${actuator_length}" y="${actuator_width}" z="${actuator_width}"/>
      </inertial>
    </link>

    <!-- Mecanum wheel attached to carriage -->
    <!-- At q=0.0 (retracted), wheel center is at wheel_radial_distance + actuator_touch -->
    <!-- Extending by q brings wheel inward toward cylinder center -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_carriage"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${-(frame_ring_radius - (wheel_radial_distance + actuator_touch))} 0 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit effort="10.0" velocity="10.0"/>
      <dynamics damping="0.2" friction="0.3"/>
    </joint>

    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Create 4 climbing wheel assemblies in X formation -->
  <xacro:climbing_wheel_assembly prefix="n" angle="${angle_n}"/>
  <xacro:climbing_wheel_assembly prefix="w" angle="${angle_w}"/>
  <xacro:climbing_wheel_assembly prefix="s" angle="${angle_s}"/>
  <xacro:climbing_wheel_assembly prefix="e" angle="${angle_e}"/>

  <!-- Frame sides forming a square -->
  <xacro:macro name="frame_side" params="name angle">
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${frame_ring_radius * cos(angle)} ${frame_ring_radius * sin(angle)} 0"
              rpy="0 0 ${angle}"/>
    </joint>
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <!-- Box: thick in X (radial), long in Y (tangential), thick in Z -->
          <box size="${arm_thickness} ${frame_size} ${arm_thickness}"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${arm_thickness} ${frame_size} ${arm_thickness}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <xacro:box_inertia m="0.5" x="${arm_thickness}" y="${frame_size}" z="${arm_thickness}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- The 4 sides of the 113cm square frame aligned with N, W, S, E anchors -->
  <xacro:frame_side name="frame_n" angle="${angle_n}"/>
  <xacro:frame_side name="frame_w" angle="${angle_w}"/>
  <xacro:frame_side name="frame_s" angle="${angle_s}"/>
  <xacro:frame_side name="frame_e" angle="${angle_e}"/>

</robot>
