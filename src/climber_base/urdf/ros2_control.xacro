<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="climber_ros2_control" params="use_sim:=true sim_gz:=true">

    <ros2_control name="climber_ros2_control" type="system">

      <xacro:if value="${use_sim and sim_gz}">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
      </xacro:if>

      <xacro:unless value="${use_sim}">
        <hardware>
          <plugin>climber_base/ClimberHardwareInterface</plugin>
          <param name="comms_timeout">0.5</param>
        </hardware>
      </xacro:unless>

      <!-- NE Wheel (Northeast - 45°) -->
      <joint name="n_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- NW Wheel (Northwest - 135°) -->
      <joint name="w_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- SW Wheel (Southwest - 225°) -->
      <joint name="s_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- SE Wheel (Southeast - 315°) -->
      <joint name="e_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Linear Actuators (prismatic - control wheel radial distance) -->
      <!-- N Actuator -->
      <joint name="n_actuator_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.16</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- W Actuator -->
      <joint name="w_actuator_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.16</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- S Actuator -->
      <joint name="s_actuator_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.16</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- E Actuator -->
      <joint name="e_actuator_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.16</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

    </ros2_control>

  </xacro:macro>

  <!-- Instantiate the ros2_control macro -->
  <xacro:climber_ros2_control use_sim="$(arg use_sim)" sim_gz="$(arg sim_gz)"/>

</robot>
