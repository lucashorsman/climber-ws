# Udev rules for Climber MCUs
# Creates stable symlinks /dev/climber_{n,w,s,e} regardless of USB enumeration order.
#
# SETUP:
#   1. Find each MCU's unique serial number:
#        udevadm info -a -n /dev/ttyACM0 | grep '{serial}'
#
#   2. Replace PLACEHOLDER_SERIAL_* below with the actual values.
#
#   3. Install:
#        sudo cp 99-climber-mcus.rules /etc/udev/rules.d/
#        sudo udevadm control --reload-rules
#        sudo udevadm trigger
#
#   4. Verify:
#        ls -la /dev/climber_*

# North MCU
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{serial}=="48CA432E0E4C", SYMLINK+="climber_n", MODE="0666"

# Northwest MCU
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{serial}=="744DBDA10314", SYMLINK+="climber_w", MODE="0666"

# Southwest MCU
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{serial}=="48CA432E0514", SYMLINK+="climber_s", MODE="0666"

# Southeast MCU
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{serial}=="48CA432ECFC8", SYMLINK+="climber_e", MODE="0666"
